# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/gymos?schema=public"

# Auth.js / NextAuth Secret & URL
AUTH_SECRET="your-secret-key-at-least-32-chars-long"
NEXTAUTH_SECRET="your-secret-key-at-least-32-chars-long"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API Key (Optional: powers conversational AI Coach with real-time biometric context)
GEMINI_API_KEY="your-gemini-api-key"
